---
export const prerender = false;
import Layout from "@layouts/DefaultPage.astro";
import { checkWebsiteInput, type Check, type Layer, type Verdict } from "@lib/check";
import { providerIconIds } from "@lib/provider-icons";

const hasUrlParam = Astro.url.searchParams.has("site") || Astro.url.searchParams.has("url");
const urlParam = Astro.url.searchParams.get("site") ?? Astro.url.searchParams.get("url") ?? "";

if (Astro.request.method === "POST") {
	const submitted = (await Astro.request.formData()).get("url");
	const redirectUrl = new URL(Astro.url);
	redirectUrl.search = new URLSearchParams({
		site: typeof submitted === "string" ? submitted.trim() : "",
	}).toString();
	return Astro.redirect(redirectUrl.toString());
}

let check: Check | undefined;
let inputError: string | undefined;
if (hasUrlParam) {
	const result = await checkWebsiteInput(urlParam);
	if (result.ok) check = result.check;
	else inputError = result.message;
}

Astro.response.headers.set(
	"Cache-Control",
	hasUrlParam
		? "public, max-age=0, s-maxage=300, stale-while-revalidate=600"
		: "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400",
);

const BOT_WALL_NAMES = {
	cloudflare: "Cloudflare",
	vercel: "Vercel",
	sgcaptcha: "SiteGround",
} as const;
const UNREACHABLE_REASONS = {
	timeout: "The site didn't respond in time",
	"network-error": "The site couldn't be reached",
	"http-error": "The site returned an error",
	"not-html": "The URL isn't an HTML page",
	"empty-body": "The site returned an empty page",
	"too-large": "The page is too large to check",
	"too-many-redirects": "Too many redirects",
	"disallowed-redirect": "The site redirected to a disallowed address",
} as const;

function verdictHeading(verdict: Verdict): string {
	if (verdict.status === "astro") return "Astro Detected";
	if (verdict.status === "not-astro") return "Not using Astro";
	return "Unable to check";
}

function verdictDetail(verdict: Verdict): string {
	if (verdict.status === "astro") return verdict.evidence.join(", ");
	if (verdict.status === "not-astro") return "No Astro evidence found";
	if (verdict.status === "blocked")
		return `Blocked by ${BOT_WALL_NAMES[verdict.by]} bot protection`;
	const status = verdict.httpStatus ? ` (${String(verdict.httpStatus)})` : "";
	return `${UNREACHABLE_REASONS[verdict.reason]}${status}`;
}

function layerSummary(layer: Layer): string {
	if (layer.status === "identified")
		return layer.providers.map((provider) => provider.name).join(", ");
	return layer.status === "hidden" ? "hidden behind CDN" : "unknown";
}

const verdict = check?.verdict;
const isAstro = verdict?.status === "astro";
const isStarlight = verdict?.status === "astro" && verdict.starlight;
const isUnsure = verdict?.status === "blocked" || verdict?.status === "unreachable";
const layers = check
	? ([
			["Edge", check.infrastructure.edge],
			["Host", check.infrastructure.host],
		] as const)
	: [];
const showInfrastructure = layers.some(([, layer]) => layer.status !== "unknown");

let title = "isAstro";
let description = "Check if a website is built with Astro";
if (check && verdict) {
	const displayUrl = check.url.replace(/^https?:\/\//, "").replace(/\/+$/, "");
	title = `is ${displayUrl} Astro? ${isAstro ? "Probably" : isUnsure ? "Not Sure" : "Probably not"}`;
	description = [
		verdictDetail(verdict),
		...layers.map(([label, layer]) => `${label}: ${layerSummary(layer)}`),
		check.showcase?.astro &&
			`Astro Showcase: ${check.showcase.astro.listed ? "listed" : "not listed"}`,
		check.showcase?.starlight &&
			`Starlight Showcase: ${check.showcase.starlight.listed ? "listed" : "not listed"}`,
	]
		.filter(Boolean)
		.join(" · ");
}

const apiHref = check ? `/api?url=${encodeURIComponent(check.url)}` : "/openapi.json";
const showcaseLinks = {
	astro: "https://github.com/withastro/roadmap/discussions/521#new_comment_field",
	starlight: "https://github.com/withastro/starlight/blob/main/CONTRIBUTING.md#sites",
} as const;
---

<Layout {title} {description}>
	<svg class="icon-sprite" aria-hidden="true">
		<symbol id="checkmark-icon" viewBox="0 0 24 24">
			<path
				fill="none"
				stroke="currentColor"
				stroke-dasharray="26"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="2"
				d="M5 11l6 6l10 -10"></path>
		</symbol>
		<symbol id="x-icon" viewBox="0 0 24 24">
			<path
				fill="none"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-width="2"
				d="M6 6l12 12M18 6L6 18"></path>
		</symbol>
		<symbol id="external-link-icon" viewBox="0 0 24 24">
			<path
				fill="none"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="1.5"
				d="M14 5h5v5m0-5l-9 9m7-1v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h5"></path>
		</symbol>
		<symbol id="infrastructure-icon" viewBox="0 0 24 24">
			<path
				fill="currentColor"
				d="M6 7.5a1 1 0 1 1 2 0a1 1 0 0 1-2 0m3 0a1 1 0 1 1 2 0a1 1 0 0 1-2 0m-2 6a1 1 0 1 0 0 2a1 1 0 0 0 0-2m3 0a1 1 0 1 0 0 2a1 1 0 0 0 0-2"
			></path>
			<path
				fill="currentColor"
				fill-rule="evenodd"
				d="M5.947 3.25A2.75 2.75 0 0 0 3.197 6v3c0 .788.332 1.499.863 2a2.74 2.74 0 0 0-.863 2v3a2.75 2.75 0 0 0 2.75 2.75h5.303v1.5H5a.75.75 0 0 0 0 1.5h14a.75.75 0 0 0 0-1.5h-6.25v-1.5h5.197a2.75 2.75 0 0 0 2.75-2.75v-3c0-.788-.331-1.499-.862-2a2.74 2.74 0 0 0 .862-2V6a2.75 2.75 0 0 0-2.75-2.75zm0 7h12c.69 0 1.25-.56 1.25-1.25V6c0-.69-.56-1.25-1.25-1.25h-12c-.69 0-1.25.56-1.25 1.25v3c0 .69.56 1.25 1.25 1.25m0 1.5c-.69 0-1.25.56-1.25 1.25v3c0 .69.56 1.25 1.25 1.25h12c.69 0 1.25-.56 1.25-1.25v-3c0-.69-.56-1.25-1.25-1.25z"
				clip-rule="evenodd"></path>
		</symbol>
	</svg>
	<main class:list={{ "has-result-page": Boolean(check) }}>
		<div class:list={["site-panel", { "has-result": Boolean(check) }]}>
			<header>
				<h1>
					{
						check ? (
							<a class="home-link" href="/">
								isAstro
							</a>
						) : (
							"isAstro"
						)
					}
				</h1>
				<p class="subtitle">
					Detect if a site is powered by <a href="https://astro.build/">Astro</a>
				</p>
			</header>

			<form method="POST">
				<label for="website-url">Website URL</label>
				<input
					id="website-url"
					type="text"
					name="url"
					inputmode="url"
					autocomplete="url"
					autocapitalize="none"
					spellcheck="false"
					aria-invalid={inputError ? "true" : undefined}
					aria-describedby={inputError ? "url-error" : undefined}
					aria-errormessage={inputError ? "url-error" : undefined}
					placeholder="https://example.com"
					required
					autofocus={!hasUrlParam || Boolean(inputError)}
					value={urlParam}
				/>
				{
					inputError && (
						<p class="field-error" id="url-error">
							{inputError}
						</p>
					)
				}
				<button type="submit">{check ? "Check" : "Check Website"}</button>
			</form>

			{
				check && verdict && (
					<section class="result-container" aria-labelledby="result-title">
						<div class={`status-box ${isAstro ? "success" : isUnsure ? "error" : "not-astro"}`}>
							<div class="detection-result">
								<h2 id="result-title" class="status-title">
									{isAstro ? (
										<img class="status-icon framework-icon" src="/astro.svg" alt="" />
									) : !isUnsure ? (
										<svg class="status-icon negative-icon" viewBox="0 0 24 24" aria-hidden="true">
											<use href="#x-icon" />
										</svg>
									) : null}
									{verdictHeading(verdict)}
								</h2>
								<dl class="result-details">
									<div>
										<dt>{isAstro ? "Evidence:" : "Details:"}</dt>
										<dd>{verdictDetail(verdict)}</dd>
									</div>
									{check.showcase?.astro && (
										<div>
											<dt>Showcase:</dt>
											<dd>
												{check.showcase.astro.listed ? (
													<span title={check.showcase.astro.title}>Listed</span>
												) : (
													<span class="showcase-not-listed">
														Not listed -
														<a
															class="inline-action"
															href={showcaseLinks.astro}
															aria-label="Add this site to the Astro Showcase"
														>
															<span>Add it</span>
															<svg class="outbound-icon" aria-hidden="true">
																<use href="#external-link-icon" />
															</svg>
														</a>
													</span>
												)}
											</dd>
										</div>
									)}
								</dl>
							</div>

							{isStarlight && (
								<div class="detection-result">
									<h3 class="status-title">
										<img class="status-icon framework-icon" src="/starlight.svg" alt="" />
										Starlight Detected
									</h3>
									{check.showcase?.starlight && (
										<dl class="result-details">
											<div>
												<dt>Showcase:</dt>
												<dd>
													{check.showcase.starlight.listed ? (
														<span title={check.showcase.starlight.title}>Listed</span>
													) : (
														<span class="showcase-not-listed">
															Not listed -
															<a
																class="inline-action"
																href={showcaseLinks.starlight}
																aria-label="Add this site to the Starlight Showcase"
															>
																<span>Add it</span>
																<svg class="outbound-icon" aria-hidden="true">
																	<use href="#external-link-icon" />
																</svg>
															</a>
														</span>
													)}
												</dd>
											</div>
										</dl>
									)}
								</div>
							)}

							{showInfrastructure && (
								<div class="detection-result">
									<h3 class="status-title">
										<svg class="status-icon" viewBox="0 0 24 24" aria-hidden="true">
											<use href="#infrastructure-icon" />
										</svg>
										Infrastructure
									</h3>
									<dl class="result-details infrastructure-details">
										{layers.map(([label, layer]) =>
											layer.status === "identified" ? (
												layer.providers.map((provider) => (
													<div>
														<dt>{label}:</dt>
														<dd class="provider-detail">
															<span class="provider-mark" aria-hidden="true">
																<svg viewBox="0 0 24 24">
																	<use
																		href={`/provider-icons.svg#${providerIconIds[provider.name] ?? "server"}`}
																	/>
																</svg>
															</span>
															<span class="provider-copy">
																<strong>{`${provider.name}:`}</strong>
																{` ${provider.evidence.join(", ")}`}
																{provider.confidence === "likely" ? " · likely" : ""}
															</span>
														</dd>
													</div>
												))
											) : (
												<div>
													<dt>{label}:</dt>
													<dd>{layer.status === "hidden" ? "Hidden behind CDN" : "Unknown"}</dd>
												</div>
											),
										)}
									</dl>
								</div>
							)}
						</div>

						<div class="result-actions">
							<button id="copyButton" type="button" class="copy-link">
								<span id="copyIcon" class="copy-icon" aria-hidden="true">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="1em"
										height="1em"
										viewBox="0 0 24 24"
										aria-hidden="true"
									>
										<path d="M0 0h24v24H0z" fill="none" />
										<path
											fill="none"
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="1.5"
											d="M20.829 12.861c.171-.413.171-.938.171-1.986s0-1.573-.171-1.986a2.25 2.25 0 0 0-1.218-1.218c-.413-.171-.938-.171-1.986-.171H11.1c-1.26 0-1.89 0-2.371.245a2.25 2.25 0 0 0-.984.984C7.5 9.209 7.5 9.839 7.5 11.1v6.525c0 1.048 0 1.573.171 1.986c.229.551.667.99 1.218 1.218c.413.171.938.171 1.986.171s1.573 0 1.986-.171m7.968-7.968a2.25 2.25 0 0 1-1.218 1.218c-.413.171-.938.171-1.986.171s-1.573 0-1.986.171a2.25 2.25 0 0 0-1.218 1.218c-.171.413-.171.938-.171 1.986s0 1.573-.171 1.986a2.25 2.25 0 0 1-1.218 1.218m7.968-7.968a11.68 11.68 0 0 1-7.75 7.9l-.218.068M16.5 7.5v-.9c0-1.26 0-1.89-.245-2.371a2.25 2.25 0 0 0-.983-.984C14.79 3 14.16 3 12.9 3H6.6c-1.26 0-1.89 0-2.371.245a2.25 2.25 0 0 0-.984.984C3 4.709 3 5.339 3 6.6v6.3c0 1.26 0 1.89.245 2.371c.216.424.56.768.984.984c.48.245 1.111.245 2.372.245H7.5"
										/>
									</svg>
								</span>
								<span id="copiedIcon" class="copy-icon" aria-hidden="true" hidden>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="1em"
										height="1em"
										viewBox="0 0 24 24"
										aria-hidden="true"
									>
										<use href="#checkmark-icon" />
									</svg>
								</span>
								<span id="copyButtonText">Copy result link</span>
							</button>
							<a class="visit-link" href={check.finalUrl}>
								Visit site
								<svg class="outbound-icon" aria-hidden="true">
									<use href="#external-link-icon" />
								</svg>
							</a>
						</div>
						<p
							id="copyStatus"
							class="copy-status"
							role="status"
							aria-live="polite"
							aria-atomic="true"
						/>
					</section>
				)
			}

			<footer>
				<a href="https://github.com/OliverSpeir/isAstro">Source Code</a>
				<a href="/showcase">Search Showcase</a>
				<a href={apiHref}>JSON API</a>
			</footer>
		</div>
	</main>

	<script>
		const copyButton = document.getElementById("copyButton") as HTMLButtonElement | null;
		const copyButtonText = document.getElementById("copyButtonText");
		const copyIcon = document.getElementById("copyIcon");
		const copiedIcon = document.getElementById("copiedIcon");
		const copyStatus = document.getElementById("copyStatus");
		let resetTimer: ReturnType<typeof setTimeout> | undefined;
		const resetCopyState = () => {
			if (!copyButtonText || !copyIcon || !copiedIcon || !copyStatus) return;
			copyButtonText.textContent = "Copy result link";
			copyIcon.hidden = false;
			copiedIcon.hidden = true;
			copiedIcon.classList.remove("animate-check");
			copyStatus.textContent = "";
		};

		copyButton?.addEventListener("click", async () => {
			if (!copyButtonText || !copyIcon || !copiedIcon || !copyStatus) return;

			try {
				await navigator.clipboard.writeText(window.location.href);
				if (resetTimer) clearTimeout(resetTimer);
				copyButtonText.textContent = "Copied";
				copyIcon.hidden = true;
				copiedIcon.hidden = false;
				copyStatus.textContent = "Result URL copied to the clipboard.";

				if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
					copiedIcon.classList.remove("animate-check");
					void copiedIcon.offsetWidth;
					copiedIcon.classList.add("animate-check");
				}

				resetTimer = setTimeout(resetCopyState, 2000);
			} catch {
				if (resetTimer) clearTimeout(resetTimer);
				copyButtonText.textContent = "Copy failed";
				copyIcon.hidden = false;
				copiedIcon.hidden = true;
				copiedIcon.classList.remove("animate-check");
				copyStatus.textContent = "Could not copy the result URL. Copy it from the address bar.";
				resetTimer = setTimeout(resetCopyState, 3000);
			}
		});
	</script>
</Layout>

<style>
	.icon-sprite {
		position: absolute;
		width: 0;
		height: 0;
		overflow: hidden;
	}

	main {
		width: 100%;
		max-width: 500px;
		padding: 24px 16px;
	}

	main.has-result-page {
		padding-block: 8px;
	}

	.site-panel {
		padding: 24px 32px 32px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background-color: var(--surface);
		box-shadow: var(--shadow);
	}

	.site-panel.has-result {
		padding-top: 18px;
		padding-bottom: 20px;
	}

	header {
		margin-bottom: 24px;
		text-align: center;
	}

	h1 {
		margin: 0 0 4px;
		font-size: 1.875rem;
		font-weight: 700;
		letter-spacing: 0;
	}

	.subtitle {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.875rem;
	}

	.has-result header {
		margin-bottom: 14px;
	}

	.has-result h1 {
		margin: 0;
		font-size: 1.375rem;
	}

	a {
		color: var(--link);
	}

	a:not(.home-link, .visit-link) {
		position: relative;
		display: inline-flex;
		align-items: center;
		width: max-content;
		text-decoration: none;
	}

	a:not(.home-link, .visit-link)::after {
		position: absolute;
		right: 0;
		bottom: 0.15em;
		left: 0;
		height: 1px;
		background: currentColor;
		content: "";
	}

	.inline-action {
		gap: 4px;
	}

	.showcase-not-listed {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}

	.outbound-icon {
		flex: 0 0 auto;
		width: 1em;
		height: 1em;
	}

	.home-link,
	.home-link:hover {
		color: inherit;
		text-decoration: none;
	}

	form {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.has-result form {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 8px;
	}

	.has-result form > label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.has-result form > input {
		grid-column: 1;
		grid-row: 1;
	}

	.has-result form > button[type="submit"] {
		grid-column: 2;
		grid-row: 1;
		width: auto;
		padding-inline: 18px;
	}

	label {
		font-size: 0.875rem;
		font-weight: 600;
	}

	input {
		box-sizing: border-box;
		width: 100%;
		padding: 12px 14px;
		border: 1px solid var(--control-border);
		border-radius: 6px;
		background-color: var(--control-bg);
		color: var(--text);
		font: inherit;
	}

	input::placeholder {
		color: var(--placeholder);
	}

	input[aria-invalid="true"] {
		border-color: var(--error-border);
	}

	.field-error {
		margin: -4px 0 0;
		color: var(--error-text);
		font-size: 0.8125rem;
	}

	button {
		font: inherit;
	}

	button[type="submit"] {
		width: 100%;
		padding: 12px 16px;
		border: 1px solid var(--control-border);
		border-radius: 6px;
		background-color: var(--surface-raised);
		color: var(--text);
		font-weight: 650;
		cursor: pointer;
		transition:
			color 0.2s ease,
			background-color 0.2s ease,
			border-color 0.2s ease;
	}

	button[type="submit"]:hover {
		border-color: var(--control-border-hover);
		background-color: var(--surface-hover);
	}

	.result-container {
		margin-top: 24px;
	}

	.has-result .result-container {
		margin-top: 16px;
	}

	.status-box {
		padding: 20px;
		border: 1px solid;
		border-radius: 8px;
	}

	.success {
		border-color: var(--success-border);
		background-color: var(--success-bg);
	}

	.success .status-title {
		color: var(--success-text);
	}

	.error {
		border-color: var(--error-border);
		background-color: var(--error-bg);
	}

	.error .status-title {
		color: var(--error-text);
	}

	.not-astro {
		border-color: var(--error-border);
		background-color: var(--error-bg);
	}

	.not-astro .status-title {
		color: var(--error-text);
	}

	.neutral {
		border-color: var(--neutral-border);
		background-color: var(--neutral-bg);
	}

	.neutral .status-title {
		color: var(--neutral-text);
	}

	.status-title {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: 0;
	}

	.detection-result + .detection-result {
		margin-top: 12px;
		padding-top: 12px;
		border-top: 1px solid var(--success-border);
	}

	.status-icon {
		flex: 0 0 auto;
		width: 1.25em;
		height: 1.25em;
		font-size: 1.25em;
	}

	.framework-icon {
		object-fit: contain;
	}

	.result-details {
		display: grid;
		gap: 12px;
		margin: 16px 0 0;
		font-size: 0.875rem;
	}

	.result-details div {
		display: grid;
		gap: 3px;
	}

	.result-details dt {
		color: var(--status-label);
